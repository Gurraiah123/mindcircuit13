pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    environment {
        IMAGE_NAME = "guru0114/batch13"
        GIT_REPO_NAME = "mindcircuit13"
        GIT_USER_NAME = "Gurraiah123"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Cloning GitHub Repository..."
                git branch: 'main',
                    url: 'https://github.com/Gurraiah123/mindcircuit13.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building Maven Project..."
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('SonarQube Scan') {
            steps {
                sh '''
                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                -Dsonar.host.url=http://54.67.148.103:9000 \
                -Dsonar.token=sqa_dfed5e5418fb49d6d5a41d6c344e9313bd645c77
                '''
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building Docker Image..."
                sh """
                docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([string(credentialsId: 'dockerhub', variable: 'DOCKER_PASSWORD')]) {
                    sh '''
                    echo "$DOCKER_PASSWORD" | docker login -u guru0114 --password-stdin
                    docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                    docker logout
                    '''
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([string(credentialsId: 'githubtoken', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                    git config --global user.email "guru167677@gmail.com"
                    git config --global user.name "Gurraiah123"

                    sed -i "s|batch13:.*|batch13:${BUILD_NUMBER}|g" deploymentfiles/deployment.yml

                    git add deploymentfiles/deployment.yml

                    git commit -m "Updated deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"

                    git push https://x-access-token:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed."
        }

        always {
            cleanWs()
        }
    }
}
